{
  "name": "mizuki-blog",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "build": {
    "command": "pnpm build"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mizuki-db",
      "database_id": "a8cc9bc8-20e7-447a-9b4a-8cc369976d95",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "d576741a577e4e8d84086a1a3048757c"
    }
  ],
  "observability": {
    "enabled": true
  }
