---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — Not Found" description="Page not found">
  <section class="py-16 flex flex-col items-center text-center">
    <div class="card-base rounded-2xl border p-10 max-w-lg w-full" style="background: var(--card-bg); border-color: var(--line-divider);">
      <div class="text-7xl font-black mb-4" style="color: var(--primary);">404</div>
      <h1 class="text-2xl font-bold mb-2" style="color: var(--btn-content);">Page Not Found</h1>
      <p class="text-sm opacity-60 mb-6">迷失在深海中？这个页面不存在或已被移动。</p>
      <a href="/" class="btn-regular inline-flex items-center justify-center rounded-full px-6 py-2.5 text-sm font-medium">
        返回首页
      </a>
    </div>
  </section>
</BaseLayout>
