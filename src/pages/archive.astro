---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import { seedData } from "../db/seed";
import { db } from "../db/client";
import { getLangFromUrl, createTranslator } from "../i18n";

const lang = getLangFromUrl(Astro.url);
const _ = createTranslator(lang);

let groups: Array<{ ym: string; cnt: number }> = [];
let posts: Array<{ id: string; slug: string; title: string; excerpt: string | null; published_at: number; ym: string }> = [];

try {
  const ymRs = await db.$client.execute({
    sql: `SELECT strftime('%Y-%m', datetime(published_at/1000, 'unixepoch')) as ym, count(*) as cnt
    FROM posts
    WHERE published_at IS NOT NULL AND status = 'published'
    GROUP BY ym
    ORDER BY ym DESC
    LIMIT 20`,
    args: [],
  });
  groups = (ymRs.rows ?? []) as unknown as typeof groups;

  const postsRs = await db.$client.execute({
    sql: `SELECT id, slug, title, excerpt, published_at,
           strftime('%Y-%m', datetime(published_at/1000, 'unixepoch')) as ym
    FROM posts
    WHERE published_at IS NOT NULL AND status = 'published'
    ORDER BY published_at DESC
    LIMIT 20`,
    args: [],
  });
  posts = (postsRs.rows ?? []) as unknown as typeof posts;
} catch {
  // fallback to seedData
  const seedPosts = seedData.posts.filter((p) => p.status === "published").slice(0, 20);
  const map = new Map<string, number>();
  posts = seedPosts.map((p) => {
    const ym = new Date(p.publishedAt).toISOString().slice(0, 7);
    map.set(ym, (map.get(ym) ?? 0) + 1);
    return {
      id: p.id,
      slug: p.slug,
      title: p.title,
      excerpt: p.excerpt ?? null,
      published_at: p.publishedAt,
      ym,
    };
  });
  groups = Array.from(map.entries())
    .map(([ym, cnt]) => ({ ym, cnt }))
    .sort((a, b) => b.ym.localeCompare(a.ym));
}

// Map ym -> posts
const grouped = new Map<string, typeof posts>();
for (const p of posts) {
  if (!grouped.has(p.ym)) grouped.set(p.ym, []);
  grouped.get(p.ym)!.push(p);
}
---

<BaseLayout title={`${_("archive.pageTitle")} — Mizuki`} description={_("archive.pageDesc")} lang={lang}>
  <section class="py-8">
    <h1 class="text-2xl font-bold mb-6">{_("archive.title")}</h1>
    {groups.length === 0 ? (
      <p class="opacity-60">{_("archive.empty")}</p>
    ) : (
      <div class="relative">
        <!-- timeline line -->
        <div class="absolute left-2 top-0 bottom-0 w-px" style="background: var(--line-divider);"></div>
        {groups.map((g) => (
          <div class="relative pl-8 pb-8">
            <span class="absolute left-0 top-1 h-4 w-4 rounded-full border-2 bg-white" style="border-color: var(--primary);"></span>
            <h2 class="text-sm font-bold tracking-widest uppercase opacity-60 mb-3">
              {g.ym} <span class="ml-2 font-normal">({g.cnt})</span>
            </h2>
            <ul class="space-y-3">
              {(grouped.get(g.ym) ?? []).map((p) => (
                <li class="rounded-lg border px-4 py-3" style="background: var(--card-bg); border-color: var(--line-divider);">
                  <a href={`/posts/${p.slug}/`} class="font-medium hover:underline" style="color: var(--btn-content);">{p.title}</a>
                  {p.excerpt && <p class="mt-1 text-sm opacity-60 line-clamp-2">{p.excerpt}</p>}
                  <time class="mt-1 block text-xs opacity-40">{new Date(p.published_at).toLocaleDateString("zh-CN")}</time>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
