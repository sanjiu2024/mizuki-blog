---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import { seedData } from "../../db/seed";
import { db } from "../../db/client";
import { getLangFromUrl, createTranslator } from "../../i18n";

const lang = getLangFromUrl(Astro.url);
const _ = createTranslator(lang);

const { tag } = Astro.params;
if (!tag) return Astro.redirect("/tags");

const url = new URL(Astro.request.url);
const page = Math.max(1, parseInt(url.searchParams.get("page") ?? "1", 10) || 1);
const rawLimit = parseInt(url.searchParams.get("limit") ?? "10", 10) || 10;
const limit = Math.min(20, Math.max(1, rawLimit));
const offset = (page - 1) * limit;

let tagRow: { id: string; name: string; slug: string } | undefined;
let posts: Array<{ id: string; slug: string; title: string; excerpt: string | null; published_at: number | null }> = [];
let total = 0;

try {
  const tagRs = await db.$client.execute({
    sql: "SELECT id, name, slug FROM tags WHERE slug = ? LIMIT 1",
    args: [tag],
  });
  const rows = (tagRs.rows ?? []) as unknown as Array<{ id: string; name: string; slug: string }>;
  tagRow = rows[0];

  if (tagRow) {
    const countRs = await db.$client.execute({
      sql: "SELECT COUNT(*) as c FROM post_tags WHERE tag_id=?",
      args: [tagRow.id],
    });
    total = Number((countRs.rows?.[0] as any)?.c ?? 0);
    const postRs = await db.$client.execute({
      sql: `SELECT p.id, p.slug, p.title, p.excerpt, p.published_at
      FROM posts p
      JOIN post_tags pt ON pt.post_id = p.id
      WHERE pt.tag_id = ?
      ORDER BY p.published_at DESC
      LIMIT ? OFFSET ?`,
      args: [tagRow.id, limit, offset],
    });
    posts = (postRs.rows ?? []) as unknown as typeof posts;
  }
} catch {
  // fallback to seedData
  const fallbackTag = seedData.tags.find((t) => t.slug === tag);
  if (fallbackTag) {
    tagRow = { id: fallbackTag.id, name: fallbackTag.name, slug: fallbackTag.slug };
    const postIds = seedData.postTags.filter((pt) => pt.tagId === fallbackTag.id).map((pt) => pt.postId);
    const all = seedData.posts
      .filter((p) => postIds.includes(p.id) && p.status === "published")
      .map((p) => ({
        id: p.id,
        slug: p.slug,
        title: p.title,
        excerpt: p.excerpt ?? null,
        published_at: p.publishedAt ?? null,
      }));
    total = all.length;
    posts = all.slice(offset, offset + limit);
  }
}
const totalPages = Math.max(1, Math.ceil(total / limit));
---

<BaseLayout title={tagRow ? `#${tagRow.name} — Mizuki` : `${_("tags.notFound")} — Mizuki`} description={tagRow ? _("tags.pageDesc") : _("tags.notFoundDesc")} lang={lang}>
  <section class="py-8">
    {tagRow ? (
      <>
        <h1 class="text-2xl font-bold mb-2">#{tagRow.name}</h1>
        <p class="text-sm opacity-60 mb-6">{_("tags.postsCount", { total, page, totalPages })}</p>
        {posts.length === 0 ? (
          <p class="opacity-60">{_("tags.noPosts")}</p>
        ) : (
          <ul class="grid gap-4">
            {posts.map((p) => (
              <li class="rounded-xl border p-5 transition-colors hover:opacity-90" style="background: var(--card-bg); border-color: var(--line-divider);">
                <a href={`/posts/${p.slug}/`} class="text-lg font-semibold hover:underline" style="color: var(--btn-content);">{p.title}</a>
                {p.excerpt && <p class="mt-1 text-sm opacity-70">{p.excerpt}</p>}
                {p.published_at && <time class="mt-2 block text-xs opacity-50">{new Date(p.published_at).toLocaleDateString("zh-CN")}</time>}
              </li>
            ))}
          </ul>
        )}
        {totalPages > 1 && (
          <nav class="mt-6 flex items-center gap-2 text-sm">
            {page > 1 && <a href={`/tags/${tag}?page=${page-1}&limit=${limit}`} class="btn-regular px-3 py-1.5">{_("pagination.prev")}</a>}
            <span class="opacity-60">{_("tags.page", { page, totalPages })}</span>
            {page < totalPages && <a href={`/tags/${tag}?page=${page+1}&limit=${limit}`} class="btn-regular px-3 py-1.5">{_("pagination.next")}</a>}
          </nav>
        )}
      </>
    ) : (
      <>
        <h1 class="text-2xl font-bold mb-4">{_("tags.notFound")}</h1>
        <p class="opacity-60">{_("tags.notFoundName", { tag: tag ?? "" })}</p>
        <a href="/tags" class="mt-4 inline-block text-sm underline">{_("tags.browseAll")}</a>
      </>
    )}
  </section>
</BaseLayout>
