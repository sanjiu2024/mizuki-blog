---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import { db } from "../db/client";

type FriendRow = {
  id: string;
  name: string;
  url: string;
  description: string | null;
  avatar: string | null;
};

let friends: FriendRow[] = [];
try {
  const rs = await db.$client.execute({
    sql: "SELECT id, name, url, description, avatar FROM friends ORDER BY sort ASC, created_at ASC",
    args: [],
  });
  friends = (rs.rows as unknown as Array<Record<string, unknown>>).map((r) => ({
    id: String(r.id ?? ""),
    name: String(r.name ?? ""),
    url: String(r.url ?? ""),
    description: (r.description as string | null) ?? null,
    avatar: (r.avatar as string | null) ?? null,
  }));
} catch {
  friends = [];
}
---
<BaseLayout title="Friends — Mizuki">
  <div class="col-span-1 lg:col-start-2 py-8">
    <div class="card-base enable-card-border p-6 sm:p-8" style="border-radius: var(--radius-large);">
      <div class="mb-6 flex items-start justify-between gap-4">
        <div>
          <h1 class="flex items-center gap-2 text-2xl font-bold">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--primary);"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            友情链接
            {friends.length > 0 && (
              <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold" style="background: var(--btn-regular-bg); color: var(--btn-content);">{friends.length} 位朋友</span>
            )}
          </h1>
          <p class="mt-2 text-sm opacity-60">欢迎互换友链 — 点击任意卡片即可访问朋友的小站。</p>
        </div>
      </div>
      {friends.length === 0 ? (
        <p class="text-sm opacity-50 py-8 text-center">博主还没有添加友情链接，敬请期待。</p>
      ) : (
        <div class="grid sm:grid-cols-2 gap-4">
          {friends.map((f) => (
            <a href={f.url} target="_blank" rel="noopener noreferrer" title={`${f.name} — ${f.description ?? f.url}`} class="friend-link-card card-base group flex gap-3 p-4 transition-all duration-150 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2" style="border-radius: var(--radius-large); border: 1px solid var(--line-divider); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);">
              {f.avatar ? (
                <img src={f.avatar} class="friend-avatar h-11 w-11 shrink-0 rounded-xl object-cover" alt={`${f.name} 的头像`} loading="lazy" style="box-shadow: 0 0 0 1px var(--line-divider);" />
              ) : (
                <div class="friend-avatar h-11 w-11 shrink-0 rounded-xl flex items-center justify-center text-white text-lg font-bold" style="background: var(--primary);" aria-hidden="true">{f.name.slice(0, 1)}</div>
              )}
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1.5">
                  <span class="font-semibold text-sm truncate">{f.name}</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 opacity-0 transition-opacity duration-150 group-hover:opacity-60 group-focus-visible:opacity-60"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
                </div>
                <div class="mt-0.5 text-xs opacity-60" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{f.description ?? f.url}</div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
