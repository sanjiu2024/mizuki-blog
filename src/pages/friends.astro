---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import { db } from "../db/client";

type FriendRow = {
  id: string;
  name: string;
  url: string;
  description: string | null;
  avatar: string | null;
};

let friends: FriendRow[] = [];
try {
  const rs = await db.$client.execute({
    sql: "SELECT id, name, url, description, avatar FROM friends ORDER BY sort ASC, created_at ASC",
    args: [],
  });
  friends = (rs.rows as unknown as Array<Record<string, unknown>>).map((r) => ({
    id: String(r.id ?? ""),
    name: String(r.name ?? ""),
    url: String(r.url ?? ""),
    description: (r.description as string | null) ?? null,
    avatar: (r.avatar as string | null) ?? null,
  }));
} catch {
  friends = [];
}
---
<BaseLayout title="Friends — Mizuki">
  <div class="col-span-1 lg:col-start-2 py-8">
    <div class="card-base enable-card-border p-6 sm:p-8" style="border-radius: var(--radius-large);">
      <h1 class="text-2xl font-bold mb-2">友链</h1>
      <p class="text-sm opacity-60 mb-6">Mizuki 风格友链卡片，M3 圆角 + 荧光边框。</p>
      {friends.length === 0 ? (
        <p class="text-sm opacity-50 py-8 text-center">博主还没有添加友情链接，敬请期待。</p>
      ) : (
        <div class="grid sm:grid-cols-2 gap-4">
          {friends.map((f) => (
            <a href={f.url} target="_blank" rel="noopener noreferrer" class="card-base p-4 hover:shadow-md transition flex gap-3" style="border-radius: var(--radius-large); border: 1px solid var(--line-divider);">
              {f.avatar ? (
                <img src={f.avatar} class="h-10 w-10 rounded-lg object-cover" alt={f.name} loading="lazy" />
              ) : (
                <div class="h-10 w-10 rounded-lg flex items-center justify-center text-white font-bold" style="background: var(--primary);">{f.name.slice(0, 1)}</div>
              )}
              <div class="min-w-0"><div class="font-semibold text-sm truncate">{f.name}</div><div class="text-xs opacity-60 truncate">{f.description ?? f.url}</div></div>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
