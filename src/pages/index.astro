---
import BaseLayout from "../layouts/BaseLayout.astro";
import Banner from "../components/Banner.astro";
import Card from "../components/Card.astro";
import { getLangFromUrl, createTranslator } from "../i18n";
import { seedData } from "../db/seed";
import { db } from "../db/client";
import { posts as postsTable, postTags, tags as tagsTable } from "../db/schema";
import { eq, sql } from "drizzle-orm";

// Pagination
const url = new URL(Astro.request.url);
const pageParam = url.searchParams.get("page");
let page = parseInt(pageParam || "1", 10);
if (Number.isNaN(page) || page < 1) page = 1;
const limit = 10;
const offset = (page - 1) * limit;

// Try D1 first, fallback to seedData mock
type PostRow = { id: string; slug: string; title: string; excerpt: string | null; content: string; cover: string | null; category: string | null; publishedAt?: number | null; createdAt: number; tags?: string[] };

let posts: PostRow[] = [];
let total = 0;
let usedMock = false;

try {
  const countRows = await db
    .select({ cnt: sql<number>`count(*)` })
    .from(postsTable)
    .where(eq(postsTable.status, "published"));
  total = countRows[0]?.cnt ?? 0;
  const rows = await db.query.posts.findMany({
    where: (p, { eq }) => eq(p.status, "published"),
    orderBy: (p, { desc }) => [desc(p.publishedAt), desc(p.createdAt)],
    limit,
    offset,
  });
  for (const r of rows) {
    const tagRows = await db
      .select({ slug: tagsTable.slug })
      .from(tagsTable)
      .innerJoin(postTags, eq(postTags.tagId, tagsTable.id))
      .where(eq(postTags.postId, r.id));
    const rec = r as unknown as Record<string, unknown>;
    posts.push({
      id: r.id,
      slug: r.slug,
      title: r.title,
      excerpt: r.excerpt,
      content: r.content,
      cover: (rec.cover as string | null) ?? null,
      category: (rec.category as string | null) ?? null,
      publishedAt: r.publishedAt,
      createdAt: r.createdAt,
      tags: tagRows.map((x) => x.slug),
    });
  }
  if (posts.length === 0 && total === 0) {
    throw new Error("empty db");
  }
} catch {
  usedMock = true;
  const all = seedData.posts.map((p) => {
    const rec = p as unknown as Record<string, unknown>;
    return {
      id: p.id,
      slug: p.slug,
      title: p.title,
      excerpt: p.excerpt,
      content: p.content,
      cover: (rec.cover as string | null) ?? null,
      category: (rec.category as string | null) ?? null,
      publishedAt: p.publishedAt,
      createdAt: p.createdAt,
      tags: seedData.postTags.filter((pt) => pt.postId === p.id).map((pt) => {
        const tag = seedData.tags.find((t) => t.id === pt.tagId);
        return tag?.slug ?? "";
      }).filter(Boolean),
    };
  });
  total = all.length;
  posts = all.slice(offset, offset + limit);
}

const totalPages = Math.max(1, Math.ceil(total / limit));
if (page > totalPages) page = totalPages;

const hasPrev = page > 1;
const hasNext = page < totalPages;

const lang = getLangFromUrl(Astro.url);
const _ = createTranslator(lang);
---

<BaseLayout title={_("site.title")} lang={lang}>
  <!-- Banner full-bleed -->
  <div style="grid-column: 1 / -1; margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw); margin-top: calc(-1rem);">
    <Banner />
  </div>

  <!-- Content area -->
  <div class="col-span-1 lg:col-start-2 w-full min-w-0">
    <div id="post-list" class="pt-6 scroll-mt-20">
      <div class="flex items-baseline justify-between mb-4">
        <h2 class="text-xl font-bold tracking-tight" style="color: oklch(0.25 0.02 var(--hue));">{_("home.latestPosts")}</h2>
        <span class="text-xs font-medium px-2.5 py-1 rounded-full" style="background: var(--btn-regular-bg); color: var(--btn-content);">
          {_("home.postsCount", { total, page, totalPages })}
        </span>
      </div>

      {posts.length === 0 ? (
        <div class="card-base enable-card-border p-10 text-center" style="border-radius: var(--radius-large);">
          <p class="text-lg font-semibold" style="color: oklch(0.45 0.03 var(--hue));">{_("home.emptyTitle")}</p>
          <p class="text-sm mt-2" style="color: oklch(0.55 0.02 var(--hue));">{_("home.emptyDescription")}</p>
          {usedMock && <p class="text-xs mt-3 opacity-60">{_("home.mockNotice")}</p>}
        </div>
      ) : (
        <div class="grid gap-4 sm:gap-5">
          {posts.map((post) => (
            <Card
              href={`/posts/${post.slug}`}
              title={post.title}
              excerpt={post.excerpt}
              date={post.publishedAt ?? post.createdAt}
              tags={post.tags ?? []}
              cover={post.cover}
              category={post.category}
            />
          ))}
        </div>
      )}

      <!-- Pagination -->
      {totalPages > 1 && (
        <nav class="mt-8 flex items-center justify-between gap-2" aria-label={_("pagination.page")}>
          <a
            href={hasPrev ? `/?page=${page - 1}#post-list` : undefined}
            aria-disabled={!hasPrev}
            class:list={["btn-regular px-4 py-2 text-sm font-medium", !hasPrev && "pointer-events-none opacity-40"]}
          >
            {_("pagination.prev")}
          </a>
          <div class="flex items-center gap-1.5">
            {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
              <a
                href={`/?page=${n}#post-list`}
                aria-current={n === page ? "page" : undefined}
                class:list={["inline-flex h-8 min-w-8 items-center justify-center rounded-full text-sm font-medium transition", n === page ? "text-white shadow" : "btn-plain"]}
                style={n === page ? "background: var(--primary);" : undefined}
              >
                {n}
              </a>
            ))}
          </div>
          <a
            href={hasNext ? `/?page=${page + 1}#post-list` : undefined}
            aria-disabled={!hasNext}
            class:list={["btn-regular px-4 py-2 text-sm font-medium", !hasNext && "pointer-events-none opacity-40"]}
          >
            {_("pagination.next")}
          </a>
        </nav>
      )}
    </div>
  </div>

  <!-- Sidebar placeholder (desktop only) -->
  <aside class="hidden lg:block lg:col-start-1 lg:row-start-2">
    <div class="sticky top-[4.5rem] space-y-4">
      <div class="card-base enable-card-border p-5" style="border-radius: var(--radius-large);">
        <h3 class="font-semibold text-sm mb-2" style="color: var(--btn-content);">{_("home.aboutTitle")}</h3>
        <p class="text-sm leading-relaxed" style="color: oklch(0.5 0.02 var(--hue));">{_("home.aboutText")}</p>
      </div>
      <div class="card-base enable-card-border p-5" style="border-radius: var(--radius-large);">
        <h3 class="font-semibold text-sm mb-3" style="color: var(--btn-content);">{_("home.linksTitle")}</h3>
        <ul class="space-y-1.5 text-sm">
          <li><a href={lang === "en" ? "/en/" : "/"} class="btn-plain px-2 py-1 inline-flex">{_("nav.home")}</a></li>
          <li><a href="/posts/hello-mizuki" class="btn-plain px-2 py-1 inline-flex">Hello Mizuki</a></li>
          <li><a href="/api/posts" class="btn-plain px-2 py-1 inline-flex">API /posts</a></li>
        </ul>
      </div>
    </div>
  </aside>
</BaseLayout>
