---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { seedData } from "../../db/seed";
import { db } from "../../db/client";
import { postTags, tags as tagsTable } from "../../db/schema";
import { eq } from "drizzle-orm";

export const prerender = false;

const { slug } = Astro.params;
const slugStr = Array.isArray(slug) ? slug.join("/") : slug ?? "";

type PostRow = { id: string; slug: string; title: string; excerpt: string | null; content: string; cover: string | null; category: string | null; status: string; publishedAt?: number | null; createdAt: number; tags?: string[]; views: number; authorId?: string | null; authorName?: string | null; authorImage?: string | null };

let post: PostRow | null = null;
const isPreview = Astro.url.searchParams.get("preview") === "1";

try {
  if (slugStr) {
    const row = await db.query.posts.findFirst({
      where: (p, { eq, and }) =>
        isPreview ? eq(p.slug, slugStr) : and(eq(p.slug, slugStr), eq(p.status, "published")),
    });
    if (row) {
      const tagRows = await db
        .select({ slug: tagsTable.slug })
        .from(tagsTable)
        .innerJoin(postTags, eq(postTags.tagId, tagsTable.id))
        .where(eq(postTags.postId, row.id));
      const r = row as unknown as Record<string, unknown>;
      // Increment view count, then read back
      let views = Number((r.views as number | null) ?? 0);
      try {
        await db.$client.execute({
          sql: "UPDATE posts SET views = views + 1 WHERE id=?",
          args: [row.id],
        });
        const vRow = await db.$client.execute({
          sql: "SELECT views FROM posts WHERE id=?",
          args: [row.id],
        });
        const v = vRow.rows?.[0] as Record<string, unknown> | undefined;
        if (v && v.views != null) views = Number(v.views);
        else views += 1;
      } catch {
        views += 1;
      }
      // Author via JOIN users
      let authorName: string | null = null;
      let authorImage: string | null = null;
      try {
        const aRow = await db.$client.execute({
          sql: "SELECT users.name, users.image FROM users INNER JOIN posts ON posts.author_id = users.id WHERE posts.id=?",
          args: [row.id],
        });
        const a = aRow.rows?.[0] as Record<string, unknown> | undefined;
        authorName = (a?.name as string | null) ?? null;
        authorImage = (a?.image as string | null) ?? null;
      } catch {
        authorName = null;
        authorImage = null;
      }
      post = {
        id: row.id,
        slug: row.slug,
        title: row.title,
        excerpt: row.excerpt,
        content: row.content,
        cover: (r.cover as string | null) ?? null,
        category: (r.category as string | null) ?? "未分类",
        status: (r.status as string) ?? "published",
        publishedAt: row.publishedAt,
        createdAt: row.createdAt,
        tags: tagRows.map((x) => x.slug),
        views,
        authorId: (r.authorId as string | null) ?? (r.author_id as string | null) ?? null,
        authorName,
        authorImage,
      };
    }
  } else {
    throw new Error("no db");
  }
} catch {
  // fallback mock
  const found = seedData.posts.find((p) => p.slug === slugStr);
  if (found) {
    const f = found as unknown as Record<string, unknown>;
    post = {
      id: found.id,
      slug: found.slug,
      title: found.title,
      excerpt: found.excerpt,
      content: found.content,
      cover: (f.cover as string | null) ?? null,
      category: (f.category as string | null) ?? "未分类",
      status: found.status,
      publishedAt: found.publishedAt,
      createdAt: found.createdAt,
      tags: seedData.postTags.filter((pt) => pt.postId === found.id).map((pt) => seedData.tags.find((t) => t.id === pt.tagId)?.slug ?? "").filter(Boolean),
      views: Number((f.views as number | null) ?? 0),
      authorId: (f.authorId as string | null) ?? null,
      authorName: null,
      authorImage: null,
    };
  }
}

if (!post) {
  Astro.response.status = 404;
}

let likeCount = 0;
if (post) {
  try {
    const r = await db.$client.execute({
      sql: "SELECT COUNT(*) as c FROM post_likes WHERE post_id=?",
      args: [post.id],
    });
    const row = r.rows?.[0] as Record<string, unknown> | undefined;
    likeCount = Number(row?.c ?? 0);
  } catch {
    likeCount = 0;
  }
}

function markdownToHtml(md: string): string {
  // minimal markdown: headings, bold, italic, code, links, paragraphs, lists
  let html = md
    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
    // restore code blocks first
    .replace(/```([\s\S]*?)```/g, (_m, code) => `<pre class="not-prose rounded-lg p-4 overflow-auto text-sm" style="background: oklch(0.18 0.02 var(--hue)); color: #e6e6e6;"><code>${code.trim()}</code></pre>`)
    .replace(/`([^`]+)`/g, '<code class="px-1.5 py-0.5 rounded text-sm" style="background: var(--btn-regular-bg);">$1</code>')
    .replace(/^### (.+)$/gm, '<h3 class="text-lg font-bold mt-6 mb-2">$1</h3>')
    .replace(/^## (.+)$/gm, '<h2 class="text-xl font-bold mt-8 mb-3">$1</h2>')
    .replace(/^# (.+)$/gm, '<h1 class="text-2xl font-black mt-2 mb-4">$1</h1>')
    .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
    .replace(/\*(.+?)\*/g, "<em>$1</em>")
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="underline decoration-2 underline-offset-4" style="color: var(--primary);">$1</a>')
    .replace(/^- (.+)$/gm, "<li>$1</li>");

  // wrap loose lines into paragraphs (naive)
  html = html.split(/\n{2,}/).map(block => {
    const t = block.trim();
    if (!t) return "";
    if (t.startsWith("<h") || t.startsWith("<pre") || t.startsWith("<li") || t.startsWith("<ul")) return t;
    if (t.startsWith("<li")) return `<ul class="list-disc pl-5 my-3 space-y-1">${t}</ul>`;
    // if block contains <li> items, wrap
    if (t.includes("<li>")) return `<ul class="list-disc pl-5 my-3 space-y-1">${t}</ul>`;
    return `<p class="my-3 leading-relaxed">${t.replace(/\n/g, "<br/>")}</p>`;
  }).join("\n");

  return html;
}

const contentHtml = post ? markdownToHtml(post.content) : "";
const dateSource = post ? ((post.publishedAt ?? post.createdAt) as number) : 0;
const dateLabel = post ? new Date(dateSource).toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" }) : "";
const dateTimeLabel = post ? new Date(dateSource).toLocaleString("zh-CN") : "";
---

<BaseLayout title={post ? `${post.title} — Mizuki` : "Not found — Mizuki"} description={post?.excerpt ?? "Post not found"}>
  <div class="col-span-1 lg:col-start-2 w-full min-w-0">
    {post ? (
      <article class="card-base enable-card-border p-6 sm:p-8 lg:p-10 onload-animation" style="border-radius: var(--radius-large);">
        <a href="/" class="inline-flex items-center gap-1 text-sm mb-4 btn-plain px-2 py-1 -ml-2">← Back to home</a>
        {isPreview && post.status !== "published" && (
          <p class="mb-4 inline-flex px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300">草稿预览 · 仅持有链接者可见</p>
        )}

        {post.cover && (
          <img src={post.cover} alt={post.title} loading="lazy" class="w-full max-h-80 object-cover rounded-2xl border mb-6" style="border-color: var(--line-divider);" />
        )}
        <header class="mb-6">
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black leading-tight tracking-tight" style="color: oklch(0.2 0.02 var(--hue));">
            {post.title}
          </h1>
          <div class="mt-3 flex flex-wrap items-center gap-3 text-sm" style="color: oklch(0.5 0.02 var(--hue));">
            {post.authorName && (
              <span class="inline-flex items-center gap-1.5">
                {post.authorImage ? (
                  <img src={post.authorImage} alt={post.authorName} loading="lazy" class="w-6 h-6 rounded-full object-cover" style="border:1px solid var(--line-divider);" />
                ) : (
                  <span class="w-6 h-6 rounded-full inline-flex items-center justify-center text-xs font-bold" style="background: var(--primary); color: white;">{post.authorName.slice(0, 1).toUpperCase()}</span>
                )}
                <span class="font-medium">{post.authorName}</span>
              </span>
            )}
            <time datetime={new Date(dateSource).toISOString()} title={dateTimeLabel}>{dateLabel}</time>
            <span class="inline-flex items-center gap-1" aria-label={`浏览量 ${post.views}`}>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
              {post.views}
            </span>
            {post.category && (
              <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold" style="background: var(--primary); color: white;">{post.category}</span>
            )}
            {post.tags && post.tags.length > 0 && (
              <span class="flex gap-1.5 flex-wrap">
                {post.tags.map((t) => (
                  <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-medium" style="background: var(--btn-regular-bg); color: var(--btn-content);">#{t}</span>
                ))}
              </span>
            )}
          </div>
          {post.excerpt && (
            <p class="mt-4 text-base leading-relaxed p-4 rounded-xl" style="background: var(--btn-regular-bg); color: oklch(0.4 0.02 var(--hue));">
              {post.excerpt}
            </p>
          )}
          <div class="mt-4 flex items-center gap-2">
            <button
              id="post-like-btn"
              type="button"
              data-post-id={post.id}
              aria-label="给文章点赞"
              aria-pressed="false"
              class="inline-flex items-center gap-1.5 rounded-full px-4 py-1.5 text-sm font-semibold transition hover:-translate-y-0.5"
              style="background: var(--btn-regular-bg); color: var(--btn-content);"
            >
              <svg id="post-like-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
              </svg>
              <span id="post-like-count">{likeCount}</span>
            </button>
          </div>
        </header>

        <div class="prose prose-neutral dark:prose-invert max-w-none prose-headings:tracking-tight prose-a:decoration-2" set:html={contentHtml} />
        <script is:inline define:vars={{ postId: post.id, initialCount: likeCount }}>
          (() => {
            const btn = document.getElementById('post-like-btn');
            const icon = document.getElementById('post-like-icon');
            const countEl = document.getElementById('post-like-count');
            if (!btn || !icon || !countEl) return;
            const paint = (liked, count) => {
              countEl.textContent = String(count);
              btn.setAttribute('aria-pressed', liked ? 'true' : 'false');
              icon.setAttribute('fill', liked ? 'currentColor' : 'none');
              btn.style.color = liked ? 'var(--primary)' : 'var(--btn-content)';
            };
            let liked = false;
            let count = initialCount;
            paint(false, count);
            fetch(`/api/posts/${postId}/like`, { credentials: 'include' })
              .then((r) => (r.ok ? r.json() : null))
              .then((d) => { if (d && typeof d.count === 'number') { liked = !!d.liked; count = d.count; paint(liked, count); } })
              .catch(() => {});
            btn.addEventListener('click', async () => {
              const prevLiked = liked;
              const prevCount = count;
              liked = !liked;
              count = prevCount + (liked ? 1 : -1);
              paint(liked, Math.max(0, count));
              btn.disabled = true;
              try {
                const res = await fetch(`/api/posts/${postId}/like`, { method: 'POST', credentials: 'include' });
                const d = await res.json().catch(() => ({}));
                if (res.status === 401) { window.location.href = '/login'; return; }
                if (!res.ok) throw new Error(d.error || 'Failed');
                liked = !!d.liked;
                count = typeof d.count === 'number' ? d.count : (typeof d.likeCount === 'number' ? d.likeCount : count);
                paint(liked, count);
              } catch (e) {
                console.error(e);
                liked = prevLiked;
                paint(liked, prevCount);
              } finally {
                btn.disabled = false;
              }
            });
          })();
        </script>

        <!-- Comments -->
        <section class="mt-10 pt-8" style="border-top: 1px solid var(--line-divider);">
          <h2 class="text-lg font-bold mb-3" style="color: var(--btn-content);">Comments</h2>
          <div id="comments-root" data-post-id={post.id} class="space-y-4">
            <div id="comments-list" class="space-y-3">
              <p class="text-sm opacity-60">Loading comments...</p>
            </div>
            <div id="reply-indicator" class="hidden text-xs px-1 py-1 flex items-center gap-2">
              <span class="opacity-60">Replying to <span id="reply-to-label" class="font-semibold"></span></span>
              <button id="reply-cancel" type="button" class="underline text-xs" style="color: var(--primary);">Cancel</button>
            </div>
            <form id="comment-form" class="card-base enable-card-border p-4 space-y-3" style="border-radius: var(--radius-large);">
              <div class="flex gap-3">
                <img id="comment-self-avatar" alt="我的头像" loading="lazy" class="w-9 h-9 rounded-full object-cover shrink-0 hidden" style="border:1px solid var(--line-divider);" />
                <textarea id="comment-content" placeholder="Write a comment... (login required)" rows="3" class="w-full rounded-lg border px-3 py-2 text-sm" style="background: var(--card-bg); border-color: var(--line-divider);"></textarea>
              </div>
              <div class="flex justify-between items-center">
                <a href="/login" class="text-xs underline opacity-60">Login to comment</a>
                <button type="submit" class="btn-regular px-5 py-2 text-sm font-semibold">Post comment</button>
              </div>
              <p id="comment-msg" class="text-xs hidden"></p>
            </form>
          </div>
          <script is:inline define:vars={{ postId: post.id }}>
            (async () => {
              const list = document.getElementById('comments-list');
              const form = document.getElementById('comment-form');
              const input = document.getElementById('comment-content');
              const msg = document.getElementById('comment-msg');
              const replyIndicator = document.getElementById('reply-indicator');
              const replyLabel = document.getElementById('reply-to-label');
              const replyCancel = document.getElementById('reply-cancel');
              let replyParentId = null;
              let replyParentLabel = '';
              function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
              fetch('/api/auth/get-session', { credentials: 'include' })
                .then((r) => (r.ok ? r.json() : null))
                .then((d) => {
                  const u = d && (d.user || d.data && d.data.user) || null;
                  const img = u && u.image || null;
                  if (img) {
                    const av = document.getElementById('comment-self-avatar');
                    if (av) { av.src = img; av.classList.remove('hidden'); }
                  }
                })
                .catch(() => {});
              function buildTree(rows){
                const byId = new Map(); const roots=[];
                rows.forEach(r=> byId.set(r.id, {...r, children:[]}));
                rows.forEach(r=> {
                  const n=byId.get(r.id);
                  if(r.parent_id && byId.has(r.parent_id)) byId.get(r.parent_id).children.push(n); else roots.push(n);
                });
                const sortRec=(arr)=>{ arr.sort((a,b)=>a.created_at-b.created_at); arr.forEach(x=>sortRec(x.children)); };
                sortRec(roots); return roots;
              }
              function avatarHtml(node){
                const author = node.author || {};
                const name = author.name || '匿名用户';
                const img = author.image || '';
                const initial = esc(name.slice(0,1).toUpperCase());
                const pic = img
                  ? `<img src="${esc(img)}" alt="${esc(name)}" loading="lazy" class="w-8 h-8 rounded-full object-cover shrink-0" style="border:1px solid var(--line-divider);" onerror="this.outerHTML='<span class=&quot;w-8 h-8 rounded-full inline-flex items-center justify-center text-xs font-bold shrink-0&quot; style=&quot;background:var(--primary);color:white;&quot;>'+${initial}+'</span>'" />`
                  : `<span class="w-8 h-8 rounded-full inline-flex items-center justify-center text-xs font-bold shrink-0" style="background:var(--primary);color:white;">${initial}</span>`;
                return `<div class="flex items-center gap-2 min-w-0">${pic}<span class="font-semibold text-sm truncate">${esc(name)}</span></div>`;
              }
              function renderNode(node, depth){
                const pad = Math.min(depth, 5);
                const indent = pad ? `margin-left:${pad*16}px; border-left:2px solid var(--line-divider); padding-left:12px;` : '';
                const likeCount = node.likeCount ?? node.like_count ?? 0;
                const time = new Date(node.created_at).toLocaleString();
                const childrenHtml = (node.children||[]).map(c=>renderNode(c, depth+1)).join('');
                return `<div class="card-base p-3 text-sm" style="border-radius:0.75rem; border:1px solid var(--line-divider); ${indent}">
                  <div class="flex justify-between items-center gap-2">
                    ${avatarHtml(node)}
                    <div class="flex items-center gap-2 shrink-0">
                      <button data-like="${node.id}" class="inline-flex items-center gap-1 text-xs btn-plain px-2 py-1" aria-label="给评论点赞">♥ <span class="like-count">${likeCount}</span></button>
                      <button data-reply="${node.id}" data-label="${esc((node.content||'').slice(0,24))}" class="text-xs btn-plain px-2 py-1">Reply</button>
                    </div>
                  </div>
                  <div class="opacity-60 text-xs mt-1">${esc(time)}</div>
                  <div class="mt-1 break-words">${esc(node.content)}</div>
                  ${childrenHtml ? `<div class="mt-3 space-y-3">${childrenHtml}</div>` : ''}
                </div>`;
              }
              const load = async () => {
                try {
                  const res = await fetch(`/api/comments?postId=${postId}`);
                  const data = await res.json();
                  const rows = data.comments || [];
                  if (!rows.length) { list.innerHTML = '<p class="text-sm opacity-60">No comments yet. Be the first!</p>'; return; }
                  const tree = data.tree && data.tree.length ? data.tree : buildTree(rows);
                  list.innerHTML = tree.map(n=>renderNode(n,0)).join('');
                  // bind reply
                  list.querySelectorAll('[data-reply]').forEach(btn=>{
                    btn.addEventListener('click', ()=>{
                      replyParentId = btn.getAttribute('data-reply');
                      replyParentLabel = btn.getAttribute('data-label') || replyParentId;
                      replyLabel.textContent = replyParentLabel;
                      replyIndicator.classList.remove('hidden');
                      input.focus();
                      input.placeholder = 'Write a reply...';
                    });
                  });
                  list.querySelectorAll('[data-like]').forEach(btn=>{
                    btn.addEventListener('click', async ()=>{
                      const cid = btn.getAttribute('data-like');
                      btn.disabled=true;
                      try{
                        let res = await fetch(`/api/comments/${cid}/like`, { method:'POST', credentials:'include' });
                        if(res.status===404){
                          res = await fetch('/api/comments/like', { method:'POST', headers:{'Content-Type':'application/json'}, credentials:'include', body: JSON.stringify({ commentId: cid }) });
                        }
                        const d=await res.json().catch(()=>({}));
                        if(res.status===401){ window.location.href='/login'; return; }
                        if(!res.ok) throw new Error(d.error||'Failed');
                        const span = btn.querySelector('.like-count');
                        const next = typeof d.likeCount==='number' ? d.likeCount : (typeof d.count==='number' ? d.count : null);
                        if(span && next!==null) span.textContent = String(next);
                        btn.style.color = d.liked ? 'var(--primary)' : '';
                        btn.setAttribute('aria-pressed', d.liked ? 'true' : 'false');
                      }catch(e){ console.error(e); }
                      btn.disabled=false;
                    });
                  });
                } catch { list.innerHTML = '<p class="text-sm opacity-60">Failed to load.</p>'; }
              };
              replyCancel?.addEventListener('click', ()=>{ replyParentId=null; replyIndicator.classList.add('hidden'); input.placeholder='Write a comment... (login required)'; });
              await load();
              form?.addEventListener('submit', async (e) => {
                e.preventDefault();
                const content = input.value.trim();
                if (!content) return;
                msg.classList.remove('hidden'); msg.textContent='Posting...'; msg.className='text-xs';
                try {
                  const payload = { postId, content };
                  if(replyParentId) payload.parentId = replyParentId;
                  const res = await fetch('/api/comments', { method:'POST', headers:{'Content-Type':'application/json'}, credentials:'include', body: JSON.stringify(payload) });
                  const data = await res.json().catch(()=>({}));
                  if (res.status === 401) { window.location.href = '/login'; return; }
                  if (!res.ok) throw new Error(data.error || 'Failed');
                  msg.textContent='Posted!'; input.value=''; replyParentId=null; replyIndicator.classList.add('hidden'); input.placeholder='Write a comment... (login required)'; await load();
                } catch(err){ msg.textContent=err.message||String(err); msg.classList.add('text-red-500'); }
                setTimeout(()=> msg.classList.add('hidden'), 2500);
              });
            })();
          </script>
        </section>
      </article>
    ) : (
      <div class="card-base enable-card-border p-10 text-center" style="border-radius: var(--radius-large);">
        <h1 class="text-2xl font-bold">404 — Post not found</h1>
        <p class="text-sm mt-2 opacity-70">No post matches slug “{slugStr}”.</p>
        <a href="/" class="btn-regular inline-flex mt-6 px-6 py-2.5 text-sm font-semibold">Go home</a>
      </div>
    )}
  </div>

  <!-- Sidebar -->
  <aside class="hidden lg:block lg:col-start-1">
    <div class="sticky top-[4.5rem] space-y-4">
      <div class="card-base enable-card-border p-5" style="border-radius: var(--radius-large);">
        <h3 class="font-semibold text-sm mb-2" style="color: var(--btn-content);">Navigation</h3>
        <ul class="space-y-1.5 text-sm">
          <li><a href="/" class="btn-plain px-2 py-1 inline-flex w-full">← All posts</a></li>
          <li><a href="/api/posts" class="btn-plain px-2 py-1 inline-flex w-full">API</a></li>
        </ul>
      </div>
    </div>
  </aside>
</BaseLayout>

<style is:global>
  :root.dark article h1 { color: oklch(0.96 0.015 var(--hue)) !important; }
</style>
