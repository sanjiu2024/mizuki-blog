---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import { db } from "../../db/client";

const me = Astro.locals.user;

type PostRow = { id: string; slug: string; title: string; status: string; created_at: number | null };
let mine: PostRow[] = [];
let total = 0;
try {
  const rs = await db.$client.execute({
    sql: "SELECT id, slug, title, status, created_at FROM posts WHERE author_id = ? ORDER BY created_at DESC",
    args: [me?.id ?? ""],
  });
  mine = rs.rows as unknown as PostRow[];
  const c = await db.$client.execute({ sql: "SELECT COUNT(*) AS n FROM posts", args: [] });
  total = Number((c.rows[0] as unknown as Record<string, unknown>).n ?? 0);
} catch {
  mine = [];
}
---

<BaseLayout title="作者后台 — Mizuki">
  <div class="col-span-1 lg:col-start-2 w-full min-w-0 py-8">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold">作者后台</h1>
        <p class="text-sm opacity-60 mt-1">欢迎，{me?.name || me?.email} · 我的文章 {mine.length} / 全站 {total}</p>
      </div>
      <a href="/admin/posts/new" class="btn-regular px-4 py-2 text-sm font-semibold rounded-lg" style="background: var(--primary); color: white;">+ 新建文章</a>
    </div>

    <div class="card-base enable-card-border overflow-hidden" style="border-radius: var(--radius-large);">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="text-xs opacity-60 border-b" style="border-color: var(--line-divider);">
            <tr>
              <th class="text-left px-4 py-3 font-medium">标题</th>
              <th class="text-left px-4 py-3 font-medium hidden sm:table-cell">Slug</th>
              <th class="text-left px-4 py-3 font-medium">状态</th>
              <th class="text-right px-4 py-3 font-medium">操作</th>
            </tr>
          </thead>
          <tbody>
            {mine.length === 0 ? (
              <tr><td colspan="4" class="text-center py-12 opacity-50">还没有文章，去写第一篇吧</td></tr>
            ) : mine.map((p) => (
              <tr class="border-b last:border-0" style="border-color: var(--line-divider);">
                <td class="px-4 py-3 font-medium max-w-[16rem] truncate">{p.title}</td>
                <td class="px-4 py-3 opacity-60 hidden sm:table-cell">{p.slug}</td>
                <td class="px-4 py-3">
                  <span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300">{p.status}</span>
                </td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                  <a href={`/posts/${p.slug}`} class="btn-plain px-3 py-1 text-xs font-medium mr-1">查看</a>
                  <a href={`/admin/posts/${p.id}`} class="btn-plain px-3 py-1 text-xs font-medium">编辑</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <div class="mt-6">
      <a href="/" class="btn-plain px-4 py-2 text-sm">← 返回首页</a>
    </div>
  </div>
</BaseLayout>
