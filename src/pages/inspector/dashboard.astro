---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import { db } from "../../db/client";

const me = Astro.locals.user;

type CommentRow = { id: string; content: string; status: string; created_at: number | null; post_title: string | null; author_name: string | null };
let pending = 0;
let totalComments = 0;
let totalPosts = 0;
let recent: CommentRow[] = [];
try {
  const p = await db.$client.execute({ sql: "SELECT COUNT(*) AS n FROM comments WHERE status = 'pending'", args: [] });
  pending = Number((p.rows[0] as unknown as Record<string, unknown>).n ?? 0);
  const t = await db.$client.execute({ sql: "SELECT COUNT(*) AS n FROM comments", args: [] });
  totalComments = Number((t.rows[0] as unknown as Record<string, unknown>).n ?? 0);
  const tp = await db.$client.execute({ sql: "SELECT COUNT(*) AS n FROM posts", args: [] });
  totalPosts = Number((tp.rows[0] as unknown as Record<string, unknown>).n ?? 0);
  const r = await db.$client.execute({
    sql: "SELECT c.id, c.content, c.status, c.created_at, p.title AS post_title, u.name AS author_name FROM comments c LEFT JOIN posts p ON p.id = c.post_id LEFT JOIN users u ON u.id = c.author_id ORDER BY c.created_at DESC LIMIT 50",
    args: [],
  });
  recent = r.rows as unknown as CommentRow[];
} catch {
  recent = [];
}
---

<BaseLayout title="督查后台 — Mizuki">
  <div class="col-span-1 lg:col-start-2 w-full min-w-0 py-8">
    <div class="mb-6">
      <h1 class="text-2xl font-bold">督查后台</h1>
      <p class="text-sm opacity-60 mt-1">欢迎，{me?.name || me?.email} · 负责内容审核与巡查</p>
    </div>

    <div class="grid grid-cols-3 gap-4 mb-6">
      <div class="card-base enable-card-border p-4 text-center" style="border-radius: var(--radius-large);">
        <div class="text-2xl font-bold" style="color: var(--primary);">{pending}</div>
        <div class="text-xs opacity-60 mt-1">待审核评论</div>
      </div>
      <div class="card-base enable-card-border p-4 text-center" style="border-radius: var(--radius-large);">
        <div class="text-2xl font-bold">{totalComments}</div>
        <div class="text-xs opacity-60 mt-1">评论总数</div>
      </div>
      <div class="card-base enable-card-border p-4 text-center" style="border-radius: var(--radius-large);">
        <div class="text-2xl font-bold">{totalPosts}</div>
        <div class="text-xs opacity-60 mt-1">文章总数</div>
      </div>
    </div>

    <div class="card-base enable-card-border overflow-hidden" style="border-radius: var(--radius-large);">
      <div class="px-4 py-3 text-sm font-semibold border-b" style="border-color: var(--line-divider);">最新评论（50）</div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="text-xs opacity-60 border-b" style="border-color: var(--line-divider);">
            <tr>
              <th class="text-left px-4 py-3 font-medium">内容</th>
              <th class="text-left px-4 py-3 font-medium hidden sm:table-cell">文章</th>
              <th class="text-left px-4 py-3 font-medium hidden md:table-cell">作者</th>
              <th class="text-left px-4 py-3 font-medium">状态</th>
            </tr>
          </thead>
          <tbody>
            {recent.length === 0 ? (
              <tr><td colspan="4" class="text-center py-12 opacity-50">暂无评论</td></tr>
            ) : recent.map((c) => (
              <tr class="border-b last:border-0" style="border-color: var(--line-divider);">
                <td class="px-4 py-3 max-w-[18rem] truncate">{c.content}</td>
                <td class="px-4 py-3 opacity-60 hidden sm:table-cell max-w-[10rem] truncate">{c.post_title ?? "-"}</td>
                <td class="px-4 py-3 opacity-60 hidden md:table-cell">{c.author_name ?? "-"}</td>
                <td class="px-4 py-3">
                  <span class={`inline-flex px-2 py-0.5 rounded-full text-xs font-medium ${c.status === "approved" ? "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300" : "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300"}`}>{c.status}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <div class="mt-6">
      <a href="/" class="btn-plain px-4 py-2 text-sm">← 返回首页</a>
    </div>
  </div>
</BaseLayout>
