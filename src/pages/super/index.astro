---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import { db } from "../../db/client";
import { getLangFromUrl, createTranslator, t as translate } from "../../i18n";

const lang = getLangFromUrl(Astro.url);
const _ = createTranslator(lang);

const me = Astro.locals.user;
if (!me || me.role !== "super_admin") {
  return new Response(translate(lang, "error.superOnly"), { status: 403 });
}

let roleCounts: Record<string, number> = {};
let postCount = 0;
let commentCount = 0;
try {
  const rc = await db.$client.execute({ sql: "SELECT role, COUNT(*) AS n FROM users GROUP BY role", args: [] });
  for (const row of rc.rows as unknown as { role: string; n: number }[]) {
    roleCounts[row.role] = Number(row.n);
  }
  const p = await db.$client.execute({ sql: "SELECT COUNT(*) AS n FROM posts", args: [] });
  postCount = Number((p.rows[0] as unknown as Record<string, unknown>).n ?? 0);
  const c = await db.$client.execute({ sql: "SELECT COUNT(*) AS n FROM comments", args: [] });
  commentCount = Number((c.rows[0] as unknown as Record<string, unknown>).n ?? 0);
} catch {
  roleCounts = {};
}

const cards = [
  { href: "/admin", title: _("admin.title"), desc: _("super.descAdmin"), count: _("super.postsCount", { n: postCount }) },
  { href: "/admin/users", title: _("users.title"), desc: _("users.subtitle"), count: _("super.usersCount", { n: Object.values(roleCounts).reduce((a, b) => a + b, 0) }) },
  { href: "/author/dashboard", title: _("author.title"), desc: _("super.descAuthor"), count: _("super.authorsCount", { n: roleCounts["author"] ?? 0 }) },
  { href: "/inspector/dashboard", title: _("inspector.title"), desc: _("super.descInspector"), count: _("super.commentsCount", { n: commentCount }) },
];
---

<BaseLayout title={`${_("super.pageTitle")} — JiuYue`} lang={lang}>
  <div class="col-span-1 lg:col-start-2 w-full min-w-0 py-8">
    <div class="mb-6">
      <h1 class="text-2xl font-bold">{_("super.title")}</h1>
      <p class="text-sm opacity-60 mt-1">{_("super.subtitle", { name: me?.name || me?.email || "" })}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {cards.map((c) => (
        <a href={c.href} class="card-base enable-card-border p-5 block hover:opacity-90" style="border-radius: var(--radius-large);">
          <div class="font-semibold">{c.title}</div>
          <div class="text-sm opacity-60 mt-1">{c.desc}</div>
          <div class="text-xs mt-2 font-medium" style="color: var(--primary);">{c.count}</div>
        </a>
      ))}
    </div>

    <div class="card-base enable-card-border p-5 mt-4" style="border-radius: var(--radius-large);">
      <div class="text-sm font-semibold mb-3">{_("super.roleDist")}</div>
      <div class="flex flex-wrap gap-2 text-xs">
        {Object.entries(roleCounts).map(([role, n]) => (
          <span class="inline-flex px-3 py-1 rounded-full font-medium bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300">{_(`role.${role}`)} × {n}</span>
        ))}
      </div>
    </div>

    <div class="mt-6">
      <a href="/" class="btn-plain px-4 py-2 text-sm">{_("super.backHome")}</a>
    </div>
  </div>
</BaseLayout>
