---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import { db } from "../../db/client";

const me = Astro.locals.user;
if (!me || me.role !== "super_admin") {
  return new Response("Forbidden — super_admin only", { status: 403 });
}

let roleCounts: Record<string, number> = {};
let postCount = 0;
let commentCount = 0;
try {
  const rc = await db.$client.execute({ sql: "SELECT role, COUNT(*) AS n FROM users GROUP BY role", args: [] });
  for (const row of rc.rows as unknown as { role: string; n: number }[]) {
    roleCounts[row.role] = Number(row.n);
  }
  const p = await db.$client.execute({ sql: "SELECT COUNT(*) AS n FROM posts", args: [] });
  postCount = Number((p.rows[0] as unknown as Record<string, unknown>).n ?? 0);
  const c = await db.$client.execute({ sql: "SELECT COUNT(*) AS n FROM comments", args: [] });
  commentCount = Number((c.rows[0] as unknown as Record<string, unknown>).n ?? 0);
} catch {
  roleCounts = {};
}

const cards = [
  { href: "/admin", title: "管理员后台", desc: "文章管理 · 新建 / 编辑 / 删除", count: `${postCount} 篇文章` },
  { href: "/admin/users", title: "用户与角色", desc: "分配作者 / 督查 / 管理员 / 超级管理员", count: `${Object.values(roleCounts).reduce((a, b) => a + b, 0)} 个用户` },
  { href: "/author/dashboard", title: "作者后台", desc: "以作者视角查看内容", count: `作者 ${roleCounts["author"] ?? 0} 人` },
  { href: "/inspector/dashboard", title: "督查后台", desc: "以督查视角巡查审核", count: `${commentCount} 条评论` },
];
---

<BaseLayout title="超级后台 — Mizuki">
  <div class="col-span-1 lg:col-start-2 w-full min-w-0 py-8">
    <div class="mb-6">
      <h1 class="text-2xl font-bold">超级后台</h1>
      <p class="text-sm opacity-60 mt-1">欢迎，{me?.name || me?.email} · 拥有全部后台访问权限</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {cards.map((c) => (
        <a href={c.href} class="card-base enable-card-border p-5 block hover:opacity-90" style="border-radius: var(--radius-large);">
          <div class="font-semibold">{c.title}</div>
          <div class="text-sm opacity-60 mt-1">{c.desc}</div>
          <div class="text-xs mt-2 font-medium" style="color: var(--primary);">{c.count}</div>
        </a>
      ))}
    </div>

    <div class="card-base enable-card-border p-5 mt-4" style="border-radius: var(--radius-large);">
      <div class="text-sm font-semibold mb-3">角色分布</div>
      <div class="flex flex-wrap gap-2 text-xs">
        {Object.entries(roleCounts).map(([role, n]) => (
          <span class="inline-flex px-3 py-1 rounded-full font-medium bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300">{role} × {n}</span>
        ))}
      </div>
    </div>

    <div class="mt-6">
      <a href="/" class="btn-plain px-4 py-2 text-sm">← 返回首页</a>
    </div>
  </div>
</BaseLayout>
