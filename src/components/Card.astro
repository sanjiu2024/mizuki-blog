---
interface Props {
  href: string;
  title: string;
  excerpt?: string | null;
  date?: string | number | null;
  tags?: string[];
}
const { href, title, excerpt, date, tags = [] } = Astro.props as Props;

function formatDate(d: string | number | null | undefined) {
  if (d == null) return "";
  const ts = typeof d === "number" ? d : Date.parse(String(d));
  if (Number.isNaN(ts)) return String(d);
  return new Date(ts).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
}
const dateLabel = formatDate(date as any);
---
<a
  href={href}
  class="card-base group block p-5 sm:p-6 enable-card-border hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200"
  style="border-radius: var(--radius-large);"
>
  <div class="flex flex-col gap-2.5">
    {dateLabel && (
      <time class="text-xs font-medium tracking-wide uppercase" style="color: var(--btn-content); opacity: 0.85;">
        {dateLabel}
      </time>
    )}
    <h3 class="text-lg sm:text-xl font-bold leading-snug line-clamp-2 group-hover:underline decoration-2 underline-offset-4" style="color: oklch(0.22 0.02 var(--hue));">
      {title}
    </h3>
    {excerpt && (
      <p class="text-sm leading-relaxed line-clamp-2" style="color: oklch(0.48 0.02 var(--hue));">
        {excerpt}
      </p>
    )}
    {tags.length > 0 && (
      <div class="mt-1 flex flex-wrap gap-1.5">
        {tags.map((t) => (
          <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium" style="background: var(--btn-regular-bg); color: var(--btn-content);">
            #{t}
          </span>
        ))}
      </div>
    )}
  </div>
</a>

<style>
  /* dark mode title color fix via CSS variable cascade - handled globally */
  :global(:root.dark) a.card-base h3 { color: oklch(0.94 0.015 var(--hue)) !important; }
  :global(:root.dark) a.card-base p { color: oklch(0.78 0.015 var(--hue)) !important; }
</style>
