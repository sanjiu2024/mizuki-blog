---
interface Props {
  href: string;
  title: string;
  excerpt?: string | null;
  date?: string | number | null;
  tags?: string[];
  cover?: string | null;
  category?: string | null;
  likeCount?: number | null;
  views?: number | null;
  authorName?: string | null;
  authorImage?: string | null;
}
const { href, title, excerpt, date, tags = [], cover = null, category = null, likeCount = null, views = null, authorName = null, authorImage = null } = Astro.props as Props;

function formatDate(d: string | number | null | undefined) {
  if (d == null) return "";
  const ts = typeof d === "number" ? d : Date.parse(String(d));
  if (Number.isNaN(ts)) return String(d);
  return new Date(ts).toLocaleDateString("zh-CN", { year: "numeric", month: "short", day: "numeric" });
}
const dateLabel = formatDate(date);
---
<a
  href={href}
  class="card-base group block p-5 sm:p-6 enable-card-border hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200"
  style="border-radius: var(--radius-large);"
>
  <div class="flex flex-col gap-2.5">
    {cover && (
      <img src={cover} alt="" loading="lazy" class="w-full h-40 object-cover rounded-xl border" style="border-color: var(--line-divider);" />
    )}
    <div class="flex flex-wrap items-center gap-2">
      {authorName && (
        <span class="inline-flex items-center gap-1.5 text-xs font-medium" style="color: var(--btn-content); opacity: 0.85;">
          {authorImage ? (
            <img src={authorImage} alt={authorName} loading="lazy" class="w-5 h-5 rounded-full object-cover" style="border:1px solid var(--line-divider);" />
          ) : (
            <span class="w-5 h-5 rounded-full inline-flex items-center justify-center text-[10px] font-bold" style="background: var(--primary); color: white;">{authorName.slice(0, 1).toUpperCase()}</span>
          )}
          {authorName}
        </span>
      )}
      {dateLabel && (
        <time class="text-xs font-medium tracking-wide uppercase" style="color: var(--btn-content); opacity: 0.85;">
          {dateLabel}
        </time>
      )}
      {category && (
        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold" style="background: var(--primary); color: white;">
          {category}
        </span>
      )}
      {views != null && (
        <span class:list={["inline-flex items-center gap-1 text-xs font-semibold", likeCount == null && "ml-auto"]} style="color: var(--btn-content); opacity: 0.8;" aria-label={`浏览量 ${views}`}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
            <circle cx="12" cy="12" r="3" />
          </svg>
          {views}
        </span>
      )}
      {likeCount != null && (
        <span class="ml-auto inline-flex items-center gap-1 text-xs font-semibold" style="color: var(--btn-content); opacity: 0.8;" aria-label={`点赞数 ${likeCount}`}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
          </svg>
          {likeCount}
        </span>
      )}
    </div>
    <h3 class="text-lg sm:text-xl font-bold leading-snug line-clamp-2 group-hover:underline decoration-2 underline-offset-4" style="color: oklch(0.22 0.02 var(--hue));">
      {title}
    </h3>
    {excerpt && (
      <p class="text-sm leading-relaxed line-clamp-2" style="color: oklch(0.48 0.02 var(--hue));">
        {excerpt}
      </p>
    )}
    {tags.length > 0 && (
      <div class="mt-1 flex flex-wrap gap-1.5">
        {tags.map((t) => (
          <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium" style="background: var(--btn-regular-bg); color: var(--btn-content);">
            #{t}
          </span>
        ))}
      </div>
    )}
  </div>
</a>

<style>
  /* dark mode title color fix via CSS variable cascade - handled globally */
  :global(:root.dark) a.card-base h3 { color: oklch(0.94 0.015 var(--hue)) !important; }
  :global(:root.dark) a.card-base p { color: oklch(0.78 0.015 var(--hue)) !important; }
</style>
