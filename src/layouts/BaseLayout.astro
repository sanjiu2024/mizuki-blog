---
import ConfigCarrier from "../components/ConfigCarrier.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/tokens.css";
import "../styles/banner.css";
import "../styles/transition.css";
import "../styles/layout.css";

interface Props {
  title?: string;
  description?: string;
}
const { title = "Mizuki — わたしの部屋", description = "Mizuki Blog — deep sea of thoughts on Cloudflare Workers." } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-image.png" />
    <meta property="og:type" content="article" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={Astro.url.href} />
    <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"BlogPosting", headline: title})} />
    <ClientRouter />
    <script is:inline>
      // early hue apply before paint
      try {
        const h = localStorage.getItem("hue") || "240";
        document.documentElement.style.setProperty("--hue", h);
      } catch {}
    </script>
    <!-- Swup placeholder: future page transition via swup / view transitions -->
  </head>
  <body class="min-h-screen antialiased overflow-x-hidden selection:bg-[var(--selection-bg)]">
    <ConfigCarrier />

    <!-- Header -->
    <header
      class="sticky top-0 z-40 backdrop-blur-xl border-b"
      style="background: color-mix(in oklch, var(--card-bg) 82%, transparent); border-color: var(--line-divider);"
    >
      <nav class="mx-auto flex h-14 max-w-[var(--layout-page-width)] items-center justify-between px-4 sm:px-6 lg:px-8">
        <a href="/" class="flex items-center gap-2 font-bold text-lg tracking-tight" style="color: var(--btn-content);">
          <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg text-white text-xs font-black" style="background: var(--primary);">M</span>
          Mizuki
        </a>
        <div class="flex items-center gap-1 sm:gap-2">
          <a href="/" class="btn-plain px-3 py-1.5 text-sm font-medium">Home</a>
          <a href="/tags" class="btn-plain px-3 py-1.5 text-sm font-medium hidden sm:inline-flex">Tags</a>
          <a href="/rss.xml" class="btn-plain px-3 py-1.5 text-sm font-medium hidden sm:inline-flex">RSS</a>
          <ThemeToggle />
          <div id="auth-area" class="flex items-center gap-2 ml-1">
            <a id="auth-login-link" href="/login" class="btn-regular px-3 py-1.5 text-sm font-medium hidden">Login</a>
            <div id="auth-user" class="hidden items-center gap-2">
              <img id="auth-avatar" alt="avatar" class="h-7 w-7 rounded-full object-cover hidden" />
              <span id="auth-name" class="text-sm font-medium max-w-[8rem] truncate hidden sm:inline"></span>
              <button id="auth-logout" class="btn-plain px-3 py-1.5 text-sm">退出</button>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <!-- Main grid slot -->
    <main id="main-grid" class="mx-auto max-w-[var(--layout-page-width)] px-4 sm:px-6 lg:px-8 pb-12">
      <slot />
    </main>

    <footer class="mx-auto max-w-[var(--layout-page-width)] px-4 sm:px-6 lg:px-8 py-8 text-center text-sm" style="color: oklch(0.55 0.02 var(--hue)); border-top: 1px solid var(--line-divider);">
      <p>© {new Date().getFullYear()} Mizuki — Built with Astro 7 & Cloudflare Workers.</p>
      <p class="mt-1 opacity-60">わたしの部屋 · Deep sea of thoughts</p>
    </footer>

    <script is:inline>
      // Swup placeholder hook — view transitions handle navigation for now
      document.addEventListener("astro:page-load", () => {
        try {
          const h = localStorage.getItem("hue") || "240";
          document.documentElement.style.setProperty("--hue", h);
        } catch {}
      });
    </script>
    <script is:inline>
      async function refreshAuth() {
        const loginLink = document.getElementById('auth-login-link');
        const userBox = document.getElementById('auth-user');
        const avatar = document.getElementById('auth-avatar');
        const nameEl = document.getElementById('auth-name');
        try {
          const res = await fetch('/api/auth/get-session', { credentials: 'include' });
          const data = await res.json().catch(() => null);
          const user = data?.user || data?.data?.user || null;
          if (user) {
            if (loginLink) loginLink.classList.add('hidden');
            if (userBox) { userBox.classList.remove('hidden'); userBox.classList.add('flex'); }
            if (nameEl) nameEl.textContent = user.name || user.email || 'User';
            if (avatar && user.image) { avatar.src = user.image; avatar.classList.remove('hidden'); }
          } else {
            if (loginLink) loginLink.classList.remove('hidden');
            if (userBox) { userBox.classList.add('hidden'); userBox.classList.remove('flex'); }
          }
        } catch {
          if (loginLink) loginLink.classList.remove('hidden');
        }
      }
      refreshAuth();
      document.addEventListener('astro:page-load', refreshAuth);
      document.getElementById('auth-logout')?.addEventListener('click', async () => {
        try { await fetch('/api/auth/sign-out', { method: 'POST', credentials: 'include' }); } catch {}
        location.href = '/';
      });
    </script>
  </body>
</html>
