---
import ConfigCarrier from "../components/ConfigCarrier.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import SearchModal from "../components/SearchModal.astro";
import { ClientRouter } from "astro:transitions";
import { getLangFromUrl, createTranslator, htmlLang, t as translate } from "../i18n";
import "../styles/tokens.css";
import "../styles/banner.css";
import "../styles/transition.css";
import "../styles/layout.css";

interface Props {
  title?: string;
  description?: string;
  lang?: "zh" | "en";
}
const detectedLang = getLangFromUrl(Astro.url);
const lang = Astro.props.lang ?? detectedLang;
const _ = createTranslator(lang);
const { title = translate(lang, "site.title"), description = translate(lang, "site.description") } = Astro.props;
const currentPath = Astro.url.pathname + Astro.url.search;

type FriendLink = {
  name: string;
  url: string;
  description: string | null;
  avatar: string | null;
};
let friendLinks: FriendLink[] = [];
try {
  const { db } = await import("../db/client");
  const rs = await db.$client.execute({
    sql: "SELECT name, url, description, avatar FROM friends ORDER BY sort ASC, created_at ASC",
    args: [],
  });
  friendLinks = (rs.rows as unknown as Array<Record<string, unknown>>).map(
    (r) => ({
      name: String(r.name ?? ""),
      url: String(r.url ?? ""),
      description: (r.description as string | null) ?? null,
      avatar: (r.avatar as string | null) ?? null,
    }),
  ).filter((f) => f.name && f.url);
} catch {
  friendLinks = [];
}
---

<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-image.png" />
    <meta property="og:type" content="article" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={Astro.url.href} />
    <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"BlogPosting", headline: title})} />
    <ClientRouter />
    <script is:inline>
      // early hue apply before paint
      try {
        const h = localStorage.getItem("hue") || "240";
        document.documentElement.style.setProperty("--hue", h);
      } catch {}
    </script>
    <!-- Swup placeholder: future page transition via swup / view transitions -->
  </head>
  <body class="min-h-screen antialiased overflow-x-hidden selection:bg-[var(--selection-bg)]" data-lang={lang}>
    <ConfigCarrier />

    <!-- Header -->
    <header
      class="sticky top-0 z-40 backdrop-blur-xl border-b"
      style="background: color-mix(in oklch, var(--card-bg) 82%, transparent); border-color: var(--line-divider);"
    >
      <nav class="mx-auto flex h-14 max-w-[var(--layout-page-width)] items-center justify-between px-4 sm:px-6 lg:px-8">
        <a href="/" class="flex items-center gap-2 font-bold text-lg tracking-tight" style="color: var(--btn-content);">
          <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg text-white text-xs font-black" style="background: var(--primary);">M</span>
          Mizuki
        </a>
        <div class="flex items-center gap-1 sm:gap-2">
          <a href={lang === "en" ? "/en/" : "/"} class="btn-plain px-3 py-1.5 text-sm font-medium">{_("nav.home")}</a>
          <a href={lang === "en" ? "/en/tags" : "/tags"} class="btn-plain px-3 py-1.5 text-sm font-medium hidden sm:inline-flex">{_("nav.tags")}</a>
          <a href="/rss.xml" class="btn-plain px-3 py-1.5 text-sm font-medium hidden sm:inline-flex">{_("nav.rss")}</a>
          <LanguageSwitcher lang={lang} currentPath={currentPath} />
          <SearchModal lang={lang} placeholder={_("search.placeholder")} searchLabel={_("nav.search")} closeLabel={_("common.close")} navigateLabel={_("searchModal.navigate")} openLabel={_("searchModal.open")} searchingText={_("searchModal.searching")} noResultsTemplate={_("searchModal.noResults")} countTemplate={_("searchModal.count")} />
          <ThemeToggle />
          <div id="auth-area" class="flex items-center gap-2 ml-1">
            <a id="auth-login-link" href={lang === "en" ? "/en/login" : "/login"} class="btn-regular px-3 py-1.5 text-sm font-medium hidden">{_("nav.login")}</a>
            <div id="auth-user" class="hidden items-center gap-2">
              <img id="auth-avatar" alt="avatar" class="h-7 w-7 rounded-full object-cover hidden" />
              <span id="auth-name" class="text-sm font-medium max-w-[8rem] truncate hidden sm:inline"></span>
              <a id="auth-backend" href="/admin" class="btn-plain px-3 py-1.5 text-sm hidden">{_("nav.admin")}</a>
              <button id="auth-logout" class="btn-plain px-3 py-1.5 text-sm">{_("nav.logout")}</button>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <!-- Main grid slot -->
    <main id="main-grid" class="mx-auto max-w-[var(--layout-page-width)] px-4 sm:px-6 lg:px-8 pb-12">
      <slot />
    </main>

    <footer class="mx-auto max-w-[var(--layout-page-width)] px-4 sm:px-6 lg:px-8 py-8 text-center text-sm" style="color: oklch(0.55 0.02 var(--hue)); border-top: 1px solid var(--line-divider);">
      {friendLinks.length > 0 && (
        <nav aria-label="友情链接" class="mb-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
          {friendLinks.map((f) => (
            <a
              href={f.url}
              target="_blank"
              rel="noopener noreferrer"
              title={f.description ?? f.name}
              class="inline-flex items-center gap-1.5 hover:opacity-100 opacity-80 transition"
            >
              {f.avatar ? (
                <img src={f.avatar} alt="" loading="lazy" class="h-4 w-4 rounded-full object-cover" />
              ) : null}
              <span>{f.name}</span>
            </a>
          ))}
        </nav>
      )}
      <p>{_("footer.copyright", { year: new Date().getFullYear() })}</p>
      <p class="mt-1 opacity-60">{_("footer.tagline")}</p>
    </footer>

    <script is:inline>
      // Swup placeholder hook — view transitions handle navigation for now
      document.addEventListener("astro:page-load", () => {
        try {
          const h = localStorage.getItem("hue") || "240";
          document.documentElement.style.setProperty("--hue", h);
        } catch {}
      });
    </script>
    <script is:inline>
      async function refreshAuth() {
        const loginLink = document.getElementById('auth-login-link');
        const userBox = document.getElementById('auth-user');
        const avatar = document.getElementById('auth-avatar');
        const nameEl = document.getElementById('auth-name');
        try {
          const res = await fetch('/api/auth/get-session', { credentials: 'include', cache: 'no-store' });
          const data = await res.json().catch(() => null);
          const user = data?.user || data?.data?.user || null;
          if (user) {
            if (loginLink) loginLink.classList.add('hidden');
            if (userBox) { userBox.classList.remove('hidden'); userBox.classList.add('flex'); }
            if (nameEl) nameEl.textContent = user.name || user.email || 'User';
            if (avatar && user.image) { avatar.src = user.image; avatar.classList.remove('hidden'); }
            const backend = document.getElementById('auth-backend');
            const homeByRole = { super_admin: '/super', admin: '/admin', author: '/author/dashboard', inspector: '/inspector/dashboard' };
            const target = homeByRole[user.role] || null;
            if (backend) {
              if (target) { backend.href = target; backend.classList.remove('hidden'); }
              else backend.classList.add('hidden');
            }
          } else {
            if (loginLink) loginLink.classList.remove('hidden');
            if (userBox) { userBox.classList.add('hidden'); userBox.classList.remove('flex'); }
          }
        } catch {
          if (loginLink) loginLink.classList.remove('hidden');
        }
      }
      refreshAuth();
      document.addEventListener('astro:page-load', refreshAuth);
      // Logout must survive ClientRouter navigations (header DOM is swapped),
      // so use document-level delegation instead of a one-time binding.
      async function doSignOut() {
        const res = await fetch('/api/auth/sign-out', {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({}),
        });
        if (!res.ok) throw new Error('sign-out failed: ' + res.status);
      }
      async function signOut() {
        const home = document.body.dataset.lang === 'en' ? '/en/' : '/';
        try {
          await doSignOut();
          const check = await fetch('/api/auth/get-session', { credentials: 'include', cache: 'no-store' });
          const data = await check.json().catch(() => null);
          const user = data?.user || data?.data?.user || null;
          if (user) await doSignOut();
        } catch {}
        location.replace(home);
      }
      document.addEventListener('click', (e) => {
        const btn = e.target && e.target.closest ? e.target.closest('#auth-logout') : null;
        if (btn) { e.preventDefault(); signOut(); }
      });
    </script>
  </body>
</html>
